// The exe's resources. configure_file() fills in the icon's path and the version.
//
// ⚠️ The icon is also the window icon: SDL takes the first RT_GROUP_ICON. Keep it the only icon in the
// binary — "first" follows the linker's order, not the ID.

#include <windows.h>

1 ICON "@PT_ICON@"

// The manifest. As numbers, so no SDK header has to define the names: 1 is
// CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 is RT_MANIFEST.
1 24 "@PT_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PT_VERSION_COMMA@
 PRODUCTVERSION @PT_VERSION_COMMA@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 en-US, 04b0 Unicode. ⚠️ Must match Translation below, or the Details tab shows blank.
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",      "PocketTracker"
            VALUE "FileDescription",  "PocketTracker - a tracker for small screens"
            VALUE "FileVersion",      "@PT_VERSION@"
            VALUE "ProductVersion",   "@PT_VERSION@"
            VALUE "InternalName",     "pockettracker-sdl"
            VALUE "OriginalFilename", "PocketTracker.exe"
            VALUE "LegalCopyright",   "GPL-3.0-or-later. See licenses\\LICENSE."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
