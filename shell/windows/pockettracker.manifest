<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  activeCodePage=UTF-8: argv, getenv and the paths handed to std::ifstream and std::filesystem are
  decoded through the process code page, otherwise the machine's locale. Windows 10 1903+ honours it;
  older Windows ignores it.

  ⚠️ The linker makes no manifest of its own (/MANIFEST:NO in shell/CMakeLists.txt), so the trustInfo
  below restates the asInvoker level its manifest carried.
--><assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- A tracker has no business asking for elevation. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11. Declaring the supported OS is what opts the process in to the
           per-version behaviour below rather than the compatibility-shimmed defaults. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

</assembly>
