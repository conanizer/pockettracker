# Line endings follow the ARTIFACT: these files are copied into the packages byte for byte, so the bytes
# a device receives must not depend on which OS ran `git clone`.

# ⚠️ Run by a Linux kernel: a CRLF shebang is `/bin/bash^M: bad interpreter` and the port never starts.
*.sh text eol=lf
# ⚠️ Run by Onion exactly as launch.sh is, though not named `.sh`.
miyoo/*.port text eol=lf

# Read by docker on Linux: a CR in a RUN line ends up inside the command.
Dockerfile text eol=lf
# Read by the bash package scripts: a CR would end up in a file name.
licenses.txt text eol=lf

# The rest of the handheld packages. They parse either way today; pinned so they stay the same bytes.
portmaster/*.json text eol=lf
portmaster/*.xml  text eol=lf
portmaster/*.md   text eol=lf
miyoo/*.json text eol=lf
miyoo/README.md text eol=lf

# The Windows zip's README, opened in Notepad.
windows/*.txt text eol=crlf

# ⚠️ Binary: committed, regenerated by a script no build runs, and corrupted by any EOL conversion.
windows/*.ico binary
miyoo/*.png binary
