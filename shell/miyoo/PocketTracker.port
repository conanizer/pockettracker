#!/bin/sh
# Standalone Ports Script Template
#
# PocketTracker's entry in Onion's ports list: Onion's standalone launcher runs
# Games/PocketTracker/launch.sh.
#
# ⚠️ A port, not an App entry: Onion records play time and the recent list only for launch commands
# under /mnt/SDCARD/Roms/. ⚠️ The file name is the name it stores; Onion renames the file `.notfound`
# while the payload named below is missing.
#
# ⚠️ KillAudioserver stays 0 though the sound service must stop: Onion's launcher does not wait for the
# chip to be released, and the app then closes straight back to the menu. launch.sh stops it and waits,
# which it can only do if it is the one that stops it. PerformanceMode stays 0: never measured here.
#
# ⚠️ Onion's import script greps each `Name=` line, first match wins: no example assignment in a comment.

# main configuration :
GameName="PocketTracker"
GameDir="PocketTracker"
GameExecutable="launch.sh"
GameDataFile="pockettracker"

# additional configuration
KillAudioserver=0
PerformanceMode=0

# specific to this port :
Arguments=""

# running command line :
/mnt/SDCARD/Emu/PORTS/launch_standalone.sh "$GameName" "$GameDir" "$GameExecutable" "$Arguments" "$GameDataFile" "$KillAudioserver" "$PerformanceMode"
