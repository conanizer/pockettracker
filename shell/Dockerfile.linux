# The desktop-Linux build container.
#
# ⚠️ `ubuntu:20.04` is the glibc floor. glibc symbols are versioned, so a binary built on a newer host
# demands that host's glibc and dies on older distributions before printing a line — while running
# fine on the box that built it. 2.31 is at or below every distribution a tester is plausibly on.
#
#     readelf -V <binary> | grep -oE 'GLIBC_[0-9.]+' | sort -Vu | tail -1     # must be <= 2.31
#
# ⚠️ SDL2 is built here only to link against, never shipped: the user's distribution provides
# libSDL2-2.0.so.0, the copy that knows their display server and audio. Hence no backends at all.
# ⚠️ 2.0.18, the first with SDL_GetTicks64(): linking against the lowest SDL the app supports turns a
# newer API into a link error here, not a crash on a tester's machine. The same pin as SDL2_TAG in
# build-portmaster.sh — raise the two together.
#
# CMake comes from Kitware: 20.04 ships 3.16, the tree needs 3.22+.
#
#     docker build -t pockettracker-linux -f shell/Dockerfile.linux shell/
#     docker run --rm -v "$PWD:/src" pockettracker-linux bash /src/shell/build-linux.sh
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

ARG CMAKE_VERSION=3.28.3
ARG SDL2_TAG=release-2.0.18

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ninja-build \
        git \
        pkg-config \
        wget \
        ca-certificates \
        file \
    && wget -qO- "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
       | tar xz -C /opt \
    && ln -s "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake" /usr/local/bin/cmake \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${SDL2_TAG}" https://github.com/libsdl-org/SDL.git /tmp/sdl2-src \
    && cmake -S /tmp/sdl2-src -B /tmp/sdl2-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TEST=OFF \
    && cmake --build /tmp/sdl2-build \
    && cmake --install /tmp/sdl2-build \
    && rm -rf /tmp/sdl2-src /tmp/sdl2-build

WORKDIR /src
