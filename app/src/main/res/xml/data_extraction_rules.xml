<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer from Android 12. The slow-audio marker belongs to this device:
     carried to a new phone it would keep that phone off the fast audio path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio-slow-open" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio-slow-open" />
    </device-transfer>
</data-extraction-rules>
