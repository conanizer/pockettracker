<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-ONLY manifest additions. SAF migration P3a scaffolding.

    ⚠️ This file exists so `SafPickerActivity` is declared in debug builds and NOWHERE ELSE. It is
    `exported` because that is the only way `adb shell am start` can reach it, and an exported
    folder-picker activity is not something to ship — being in `src/debug/` is what makes that
    structural rather than a promise. P4 deletes both this file and the activity, replacing them with
    the in-app ADD FOLDER… flow in the roots directory.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.conanizer.pockettracker.SafPickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
